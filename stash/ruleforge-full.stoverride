rules: #!replace
- GEOSITE,private,DIRECT
- GEOIP,LAN,DIRECT,no-resolve
- RULE-SET,ruleforge_Gemini,🧠 Gemini
- RULE-SET,ruleforge_AI,🤖 AI
- RULE-SET,ruleforge_YouTube,📺 YouTube
- RULE-SET,ruleforge_Netflix,🎬 Netflix
- RULE-SET,ruleforge_DisneyPlus,🏰 DisneyPlus
- RULE-SET,ruleforge_Google,🇬 Google
- RULE-SET,ruleforge_GitHub,🐙 GitHub
- DOMAIN,login.live.com,🚀 节点选择
- DOMAIN,logincdn.msauth.net,🚀 节点选择
- RULE-SET,ruleforge_Microsoft,🪟 Microsoft
- RULE-SET,ruleforge_Apple,🍎 Apple
- RULE-SET,ruleforge_Telegram,✈️ Telegram
- RULE-SET,ruleforge_PayPal,💳 PayPal
- RULE-SET,ruleforge_GlobalMedia,🎞️ 境外流媒体
- RULE-SET,ruleforge_GlobalSites,🌐 境外网站
- RULE-SET,ruleforge_Domestic,🇨🇳 国内应用
- GEOIP,CN,DIRECT,no-resolve
- MATCH,🐟 漏网之鱼
