  - 🇭🇰 香港
  - 🇯🇵 日本
  - 🇺🇸 美国
  - 🇸🇬 新加坡
  - 🇹🇼 台湾
- name: 🇨🇳 国内应用
  type: select
  proxies:
  - DIRECT
  - 🚀 节点选择
  - ⚡ 自动选择
  - 🛟 故障转移
  - 🌍 全部节点
- name: 🐟 漏网之鱼
  type: select
  proxies:
  - 🚀 节点选择
  - ⚡ 自动选择
  - 🛟 故障转移
  - 🌍 全部节点
  - DIRECT
- name: 🔗 链式中转
  type: select
  proxies:
  - ⚡ 自动选择
  - 🛟 故障转移
  - 🇭🇰 香港
  - 🇯🇵 日本
  - 🇺🇸 美国
  - 🇸🇬 新加坡
  - 🇹🇼 台湾
  - DIRECT
- name: ⚡ 自动选择
  type: select
  proxies:
  - 🇭🇰 香港自动
  - 🇯🇵 日本自动
  - 🇺🇸 美国自动
  - 🇸🇬 新加坡自动
  - 🇹🇼 台湾自动
  - 🌍 全部节点
  - DIRECT
- name: 🛟 故障转移
  type: select
  proxies:
  - 🇭🇰 香港故障转移
  - 🇯🇵 日本故障转移
  - 🇺🇸 美国故障转移
  - 🇸🇬 新加坡故障转移
  - 🇹🇼 台湾故障转移
  - 🌍 全部节点
  - DIRECT
- name: 🌍 全部节点
  type: select
  include-all: true
- name: 🇭🇰 香港
  type: select
  proxies:
  - 🇭🇰 香港自动
  - 🇭🇰 香港故障转移
  include-all: true
  filter: (?i)(香港|港澳|港区|hong ?kong|hongkong|hkg|(^|[^a-z])hk($|[^a-z])|🇭🇰|港服|港线)
- name: 🇯🇵 日本
  type: select
  proxies:
  - 🇯🇵 日本自动
  - 🇯🇵 日本故障转移
  include-all: true
  filter: (?i)(日本|japan|tokyo|東京|osaka|大阪|tyo|nrt|hnd|(^|[^a-z])jp($|[^a-z])|🇯🇵)
- name: 🇺🇸 美国
  type: select
  proxies:
  - 🇺🇸 美国自动
  - 🇺🇸 美国故障转移
  include-all: true
  filter: (?i)(美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
- name: 🇸🇬 新加坡
  type: select
  proxies:
  - 🇸🇬 新加坡自动
  - 🇸🇬 新加坡故障转移
  include-all: true
  filter: (?i)(新加坡|singapore|sin|sgp|狮城|獅城|星洲|(^|[^a-z])sg($|[^a-z])|🇸🇬)
- name: 🇹🇼 台湾
  type: select
  proxies:
  - 🇹🇼 台湾自动
  - 🇹🇼 台湾故障转移
  include-all: true
  filter: (?i)(台湾|臺灣|台灣|taiwan|tpe|taipei|台北|formosa|(^|[^a-z])tw($|[^a-z])|🇹🇼)
- name: 🇭🇰 香港自动
  type: url-test
  include-all: true
  filter: (?i)(香港|港澳|港区|hong ?kong|hongkong|hkg|(^|[^a-z])hk($|[^a-z])|🇭🇰|港服|港线)
  interval: 600
  lazy: true
- name: 🇯🇵 日本自动
  type: url-test
  include-all: true
  filter: (?i)(日本|japan|tokyo|東京|osaka|大阪|tyo|nrt|hnd|(^|[^a-z])jp($|[^a-z])|🇯🇵)
  interval: 600
  lazy: true
- name: 🇺🇸 美国自动
  type: url-test
  include-all: true
  filter: (?i)(美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇸🇬 新加坡自动
  type: url-test
  include-all: true
  filter: (?i)(新加坡|singapore|sin|sgp|狮城|獅城|星洲|(^|[^a-z])sg($|[^a-z])|🇸🇬)
  interval: 600
  lazy: true
- name: 🇹🇼 台湾自动
  type: url-test
  include-all: true
  filter: (?i)(台湾|臺灣|台灣|taiwan|tpe|taipei|台北|formosa|(^|[^a-z])tw($|[^a-z])|🇹🇼)
  interval: 600
  lazy: true
- name: 🇭🇰 香港故障转移
  type: fallback
  include-all: true
  filter: (?i)(香港|港澳|港区|hong ?kong|hongkong|hkg|(^|[^a-z])hk($|[^a-z])|🇭🇰|港服|港线)
  interval: 600
  lazy: true
- name: 🇯🇵 日本故障转移
  type: fallback
  include-all: true
  filter: (?i)(日本|japan|tokyo|東京|osaka|大阪|tyo|nrt|hnd|(^|[^a-z])jp($|[^a-z])|🇯🇵)
  interval: 600
  lazy: true
- name: 🇺🇸 美国故障转移
  type: fallback
  include-all: true
  filter: (?i)(美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇸🇬 新加坡故障转移
  type: fallback
  include-all: true
  filter: (?i)(新加坡|singapore|sin|sgp|狮城|獅城|星洲|(^|[^a-z])sg($|[^a-z])|🇸🇬)
  interval: 600
  lazy: true
- name: 🇹🇼 台湾故障转移
  type: fallback
  include-all: true
  filter: (?i)(台湾|臺灣|台灣|taiwan|tpe|taipei|台北|formosa|(^|[^a-z])tw($|[^a-z])|🇹🇼)
  interval: 600
  lazy: true
rule-providers:
  ruleforge_Gemini:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/Gemini/Gemini.yaml
    path: ./rule-providers/ruleforge_Gemini.yaml
    interval: 86400
  ruleforge_AI:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/AI/AI.yaml
    path: ./rule-providers/ruleforge_AI.yaml
    interval: 86400
  ruleforge_YouTube:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/YouTube/YouTube.yaml
