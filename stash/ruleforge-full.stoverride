rule-providers:
  ruleforge_Gemini:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/Gemini/Gemini.yaml
    path: ./rule-providers/ruleforge_Gemini.yaml
    interval: 86400
  ruleforge_AI:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/AI/AI.yaml
    path: ./rule-providers/ruleforge_AI.yaml
    interval: 86400
  ruleforge_YouTube:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/YouTube/YouTube.yaml
    path: ./rule-providers/ruleforge_YouTube.yaml
    interval: 86400
  ruleforge_Netflix:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/Netflix/Netflix.yaml
    path: ./rule-providers/ruleforge_Netflix.yaml
    interval: 86400
  ruleforge_DisneyPlus:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/DisneyPlus/DisneyPlus.yaml
    path: ./rule-providers/ruleforge_DisneyPlus.yaml
    interval: 86400
  ruleforge_Google:
    behavior: classical
