- name: 🇨🇳 国内应用
  type: select
  proxies:
  - DIRECT
- name: 🇭🇰 香港节点
  type: select
  proxies:
  - 🇭🇰 香港自动
  - 🇭🇰 香港故障转移
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:香港|港澳|港区|hong ?kong|hongkong|🇭🇰|港服|港线|(^|[^a-z])(hkg|hk)($|[^a-z]))
- name: 🇯🇵 日本节点
  type: select
  proxies:
  - 🇯🇵 日本自动
  - 🇯🇵 日本故障转移
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:日本|japan|tokyo|東京|osaka|大阪|🇯🇵|(^|[^a-z])(jp|tyo|nrt|hnd)($|[^a-z]))
- name: 🇸🇬 新加坡节点
  type: select
  proxies:
  - 🇸🇬 新加坡自动
  - 🇸🇬 新加坡故障转移
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:新加坡|singapore|狮城|獅城|星洲|🇸🇬|(^|[^a-z])(sg|sin|sgp)($|[^a-z]))
- name: 🇹🇼 台湾节点
  type: select
  proxies:
  - 🇹🇼 台湾自动
  - 🇹🇼 台湾故障转移
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:台湾|臺灣|台灣|taiwan|taipei|台北|🇹🇼|formosa|(^|[^a-z])(tw|tpe)($|[^a-z]))
- name: 🇺🇸 美国节点
  type: select
  proxies:
  - 🇺🇸 美国自动
  - 🇺🇸 美国故障转移
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
- name: 🇭🇰 香港自动
  type: url-test
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:香港|港澳|港区|hong ?kong|hongkong|🇭🇰|港服|港线|(^|[^a-z])(hkg|hk)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇯🇵 日本自动
  type: url-test
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:日本|japan|tokyo|東京|osaka|大阪|🇯🇵|(^|[^a-z])(jp|tyo|nrt|hnd)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇸🇬 新加坡自动
  type: url-test
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:新加坡|singapore|狮城|獅城|星洲|🇸🇬|(^|[^a-z])(sg|sin|sgp)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇹🇼 台湾自动
  type: url-test
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:台湾|臺灣|台灣|taiwan|taipei|台北|🇹🇼|formosa|(^|[^a-z])(tw|tpe)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇺🇸 美国自动
  type: url-test
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇭🇰 香港故障转移
  type: fallback
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:香港|港澳|港区|hong ?kong|hongkong|🇭🇰|港服|港线|(^|[^a-z])(hkg|hk)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇯🇵 日本故障转移
  type: fallback
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:日本|japan|tokyo|東京|osaka|大阪|🇯🇵|(^|[^a-z])(jp|tyo|nrt|hnd)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇸🇬 新加坡故障转移
  type: fallback
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:新加坡|singapore|狮城|獅城|星洲|🇸🇬|(^|[^a-z])(sg|sin|sgp)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇹🇼 台湾故障转移
  type: fallback
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:台湾|臺灣|台灣|taiwan|taipei|台北|🇹🇼|formosa|(^|[^a-z])(tw|tpe)($|[^a-z]))
  interval: 600
  lazy: true
- name: 🇺🇸 美国故障转移
  type: fallback
  include-all: true
  filter: (?i)^(?!.*(?:落地|landing|exit|自建)).*(?:美国|美國|united ?states|seattle|san ?jose|los ?angeles|new ?york|🇺🇸|(^|[^a-z])(usa|us|lax|sfo|sea|nyc|jfk|ord|dfw|atl|sjc)($|[^a-z]))
  interval: 600
  lazy: true
