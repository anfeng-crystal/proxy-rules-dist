    interval: 86400
  ruleforge_Telegram:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/Telegram/Telegram.yaml
    path: ./rule-providers/ruleforge_Telegram.yaml
    interval: 86400
  ruleforge_PayPal:
    behavior: classical
    format: yaml
    url: https://anfeng-crystal.github.io/proxy-rules-dist/clash/PayPal/PayPal.yaml
    path: ./rule-providers/ruleforge_PayPal.yaml
