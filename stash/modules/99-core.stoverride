name: '99 · 基础策略组（必须启用）'
desc: |-
  严格覆写：完全替换机场原策略组，只保留机场实际节点/代理集。
  策略页以本模块定义为主；必须启用并放在所有 RuleForge 业务模块最下方。
author: 'RuleForge'
version: '2026.09.26-v2'

proxy-groups: #!replace
  - name: '🚀 节点选择'
    type: select
    proxies:
