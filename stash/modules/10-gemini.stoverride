name: '10 · Gemini'
desc: |-
  Gemini 默认首选 🇺🇸 美国节点。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_Gemini:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Gemini/Gemini.yaml'
    path: './rule-providers/ruleforge_Gemini.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Gemini,🧠 Gemini'
