name: '10 · Gemini'
desc: |-
  Gemini 默认首选 RF·🇺🇸 美国。
  可单独启用/停用；依赖 99 · RuleForge Core。
author: 'RuleForge'
version: '2026.09.26'

proxy-groups:
  - name: 'RF·🧠 Gemini'
    type: select
    proxies:
      - 'RF·🇺🇸 美国'
      - 'RF·🚀 节点选择'
      - 'RF·⚡️ 自动选择'
      - 'RF·🛟 故障转移'
      - 'RF·🌍 全部节点'
      - 'RF·🇭🇰 香港'
      - 'RF·🇯🇵 日本'
      - 'RF·🇸🇬 新加坡'
      - 'RF·🇹🇼 台湾'
      - DIRECT

rule-providers:
  rf_Gemini:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Gemini/Gemini.yaml'
    path: './rule-providers/rf_Gemini.yaml'
    interval: 86400

rules:
  - 'RULE-SET,rf_Gemini,RF·🧠 Gemini'
