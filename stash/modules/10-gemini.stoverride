name: '10 · Gemini'
desc: |-
  默认首选 🇺🇸 美国。
  关闭后对应规则停用，策略组仍由 99 · 基础策略组提供。
author: 'RuleForge'
version: '2026.09.26-v2'

rule-providers:
  ruleforge_Gemini:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Gemini/Gemini.yaml'
    path: './rule-providers/ruleforge_Gemini.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Gemini,🧠 Gemini'
