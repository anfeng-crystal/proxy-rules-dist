name: '30 · YouTube'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_YouTube:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/YouTube/YouTube.yaml'
    path: './rule-providers/ruleforge_YouTube.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_YouTube,📺 YouTube'
