name: '60 · 国内应用'
desc: |-
  国内应用策略组保留可见，组内仅 DIRECT；GEOIP,CN 由 Core 直接 DIRECT。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_Domestic:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Domestic/Domestic.yaml'
    path: './rule-providers/ruleforge_Domestic.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Domestic,🇨🇳 国内应用'
