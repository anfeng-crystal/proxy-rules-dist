name: '60 · 国内应用'
desc: |-
  独立业务分流模块。
  关闭后对应规则停用，策略组仍由 99 · 基础策略组提供。
author: 'RuleForge'
version: '2026.09.26-v2'

rule-providers:
  ruleforge_Domestic:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Domestic/Domestic.yaml'
    path: './rule-providers/ruleforge_Domestic.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Domestic,🇨🇳 国内应用'
