name: '44 · Telegram'
desc: |-
  44 · Telegram 独立业务分流模块。
  可单独启用/停用；依赖 99 · RuleForge Core。
author: 'RuleForge'
version: '2026.09.26'

proxy-groups:
  - name: 'RF·✈️ Telegram'
    type: select
    proxies:
      - 'RF·🇸🇬 新加坡'
      - 'RF·🇭🇰 香港'
      - 'RF·🇺🇸 美国'
      - 'RF·🇯🇵 日本'
      - 'RF·🚀 节点选择'
      - 'RF·⚡️ 自动选择'
      - 'RF·🛟 故障转移'

rule-providers:
  rf_Telegram:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Telegram/Telegram.yaml'
    path: './rule-providers/rf_Telegram.yaml'
    interval: 86400

rules:
  - 'RULE-SET,rf_Telegram,RF·✈️ Telegram'
