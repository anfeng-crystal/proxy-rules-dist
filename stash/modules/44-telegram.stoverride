name: '44 · Telegram'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_Telegram:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Telegram/Telegram.yaml'
    path: './rule-providers/ruleforge_Telegram.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Telegram,✈️ Telegram'
