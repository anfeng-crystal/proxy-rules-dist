name: '51 · 境外网站'
desc: |-
  独立业务分流模块。
  关闭后对应规则停用，策略组仍由 99 · 基础策略组提供。
author: 'RuleForge'
version: '2026.09.26-v2'

rule-providers:
  ruleforge_GlobalSites:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/GlobalSites/GlobalSites.yaml'
    path: './rule-providers/ruleforge_GlobalSites.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_GlobalSites,🌐 境外网站'
