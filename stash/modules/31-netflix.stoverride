name: '31 · Netflix'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_Netflix:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Netflix/Netflix.yaml'
    path: './rule-providers/ruleforge_Netflix.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Netflix,🎬 Netflix'
