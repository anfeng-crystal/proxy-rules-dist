name: '42 · Microsoft'
desc: |-
  独立业务分流模块。
  关闭后对应规则停用，策略组仍由 99 · 基础策略组提供。
author: 'RuleForge'
version: '2026.09.26-v2'

rule-providers:
  ruleforge_Microsoft:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Microsoft/Microsoft.yaml'
    path: './rule-providers/ruleforge_Microsoft.yaml'
    interval: 86400

rules:
  - 'DOMAIN,login.live.com,🚀 节点选择'
  - 'DOMAIN,logincdn.msauth.net,🚀 节点选择'
  - 'RULE-SET,ruleforge_Microsoft,🪟 Microsoft'
