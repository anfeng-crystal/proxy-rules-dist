name: '42 · Microsoft'
desc: |-
  42 · Microsoft 独立业务分流模块。
  可单独启用/停用；依赖 99 · RuleForge Core。
author: 'RuleForge'
version: '2026.09.26'

proxy-groups:
  - name: 'RF·🪟 Microsoft'
    type: select
    proxies:
      - DIRECT
      - 'RF·🇭🇰 香港'
      - 'RF·🇯🇵 日本'
      - 'RF·🇺🇸 美国'
      - 'RF·🇸🇬 新加坡'
      - 'RF·🇹🇼 台湾'
      - 'RF·🚀 节点选择'
      - 'RF·⚡️ 自动选择'
      - 'RF·🛟 故障转移'

rule-providers:
  rf_Microsoft:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Microsoft/Microsoft.yaml'
    path: './rule-providers/rf_Microsoft.yaml'
    interval: 86400

rules:
  - 'DOMAIN,login.live.com,RF·🚀 节点选择'
  - 'DOMAIN,logincdn.msauth.net,RF·🚀 节点选择'
  - 'RULE-SET,rf_Microsoft,RF·🪟 Microsoft'
