name: '40 · Google'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_Google:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/Google/Google.yaml'
    path: './rule-providers/ruleforge_Google.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_Google,🇬 Google'
