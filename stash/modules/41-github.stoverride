name: '41 · GitHub'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_GitHub:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/GitHub/GitHub.yaml'
    path: './rule-providers/ruleforge_GitHub.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_GitHub,🐙 GitHub'
