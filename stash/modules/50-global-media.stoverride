name: '50 · 境外流媒体'
desc: |-
  独立业务分流模块。
author: 'RuleForge'
version: '2026.09.26-v7'

rule-providers:
  ruleforge_GlobalMedia:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/GlobalMedia/GlobalMedia.yaml'
    path: './rule-providers/ruleforge_GlobalMedia.yaml'
    interval: 86400

rules:
  - 'RULE-SET,ruleforge_GlobalMedia,🎞️ 境外流媒体'
