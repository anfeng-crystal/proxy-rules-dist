name: '50 · 境外流媒体'
desc: |-
  50 · 境外流媒体 独立业务分流模块。
  可单独启用/停用；依赖 99 · RuleForge Core。
author: 'RuleForge'
version: '2026.09.26'

proxy-groups:
  - name: 'RF·🎞️ 境外流媒体'
    type: select
    proxies:
      - 'RF·🇭🇰 香港'
      - 'RF·🇯🇵 日本'
      - 'RF·🇺🇸 美国'
      - 'RF·🇸🇬 新加坡'
      - 'RF·🇹🇼 台湾'
      - 'RF·🚀 节点选择'
      - 'RF·⚡️ 自动选择'
      - 'RF·🛟 故障转移'

rule-providers:
  rf_GlobalMedia:
    behavior: classical
    format: yaml
    url: 'https://anfeng-crystal.github.io/proxy-rules-dist/clash/GlobalMedia/GlobalMedia.yaml'
    path: './rule-providers/rf_GlobalMedia.yaml'
    interval: 86400

rules:
  - 'RULE-SET,rf_GlobalMedia,RF·🎞️ 境外流媒体'
